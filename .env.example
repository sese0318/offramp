# Copy this file to .env and fill in what you have. Every key is optional.
# With no keys the app runs on a mock model and sample taste data, and says so.
# Never commit .env.

# Nebius Token Factory (https://tokenfactory.nebius.com, API keys page)
NEBIUS_API_KEY=

# Qloo hackathon key. It only works against the hackathon base URL below.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional. Tavily web search for naming one calm episode.
TAVILY_API_KEY=

# Model ids per tier. Change these only if npm run check-keys says a model id is wrong.
NEBIUS_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
NEBIUS_BASE_URL_FAST=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL_PLANNER=nvidia/nemotron-3-super-120b-a12b
NEBIUS_BASE_URL_PLANNER=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_BASE_URL_DEEP=https://api.tokenfactory.us-central1.nebius.com/v1

# Optional. Extra JSON merged into every chat completion request, for example
# to change reasoning settings if Token Factory documents a parameter for it.
NEBIUS_EXTRA_BODY=

# Optional. Secret used to sign agent state between steps. Set a long random
# string in production. If empty, one is derived from the keys above.
OFFRAMP_STATE_SECRET=
